    "No accounts. No ads. No analytics. No generative AI. No networking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No accounts. No ads. No analytics. No generative AI. No networking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要。広告なし。分析なし。生成AIなし。ネットワーク通信なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 불필요. 광고 없음. 분석 없음. 생성형 AI 없음. 네트워크 통신 없음."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без акаунтів. Без реклами. Без аналітики. Без генеративного ШІ. Без мережі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户。无广告。无分析。无生成式 AI。无需联网。"
          }
        }
      }
