    "%lld photo(s) could not be analyzed and were skipped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld photo(s) could not be analyzed and were skipped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚の写真を分析できなかったためスキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %lld장을 분석할 수 없어 건너뛰었습니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld фото не вдалося проаналізувати, їх пропущено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 张照片无法分析，已跳过。"
